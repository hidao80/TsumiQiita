{
  "name": "tsumiqiita",
  "version": "1.8.3",
  "description": "MarkdownファイルをQiitaに投稿するelectron製デスクトップアプリです。",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "build"
  },
  "build": {
    "productName": "TsumiQiita",
    "appId": "tsumiqiita",
    "mac": {
      "target": "dmg"
    },
    "directories": {
      "output": "../build"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hidao80/TsumiQiita.git"
  },
  "author": "hidao80",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hidao80/TsumiQiita/issues"
  },
  "homepage": "https://github.com/hidao80/TsumiQiita#readme",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "escape-html": "^1.0.3",
    "github-markdown-css": "^2.10.0",
    "highlight.js": "^11.9.0",
    "markdown-it": "^15.0.0",
    "markdown-it-checkbox": "^1.1.0"
  }
}
